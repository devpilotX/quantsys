# Angel One SmartAPI credentials (execution layer - not needed by the core engine)
# NEVER commit the real .env. Secrets stay out of code and configs.
# Copy this file to .env and fill in real values there.
# NOTE 2026-06-11: the previous real credentials were exposed in a public
# commit and must be treated as compromised - regenerate API key, change PIN,
# re-enrol TOTP before any live use.
ANGEL_API_KEY=your_api_key_here
ANGEL_CLIENT_CODE=your_client_code
ANGEL_PASSWORD=your_pin
ANGEL_TOTP_SECRET=your_totp_secret

# Alerting (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Inbound Angel One postback HMAC secret (must match the relay). Unset means
# every postback is refused (503). Live arming (livegate, preflight) needs at
# least 32 random characters, e.g. python -c "import secrets; print(secrets.token_hex(32))"
ANGEL_WEBHOOK_SECRET=
# Dev only: accept UNSIGNED postbacks while no secret is set. Ignored unless ENV=dev.
# ANGEL_WEBHOOK_ALLOW_UNSIGNED=

# Dashboard SQL console connection, for a read-only NOSUPERUSER role (role SQL
# in dashboard/backend/qsdash/api/dbadmin.py). Unset: the app's own connection.
# CONSOLE_DATABASE_URL=

# Local dev only (remove / set true behind HTTPS)
# COOKIE_SECURE=false
