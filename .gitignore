# deployment report contains live credentials — NEVER commit
VPS_DEPLOYMENT_REPORT.md
VPS_DEPLOYMENT_REPORT.*

# Rendered exports (PDF/DOCX) can carry the same secrets as their source doc —
# never track them. Force a specific safe file with `git add -f <file>`.
*.pdf
*.docx

# VPS-local: DB dumps and host-specific compose override
deploy/backups/
deploy/docker-compose.override.yml

