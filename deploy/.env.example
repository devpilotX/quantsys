# VPS secrets for docker-compose — copy to deploy/.env and fill in.
# NEVER commit the real file.

POSTGRES_PASSWORD=generate_a_long_random_password

# Angel One (live execution — required only when the broker adapter ships)
ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
ANGEL_PASSWORD=
ANGEL_TOTP_SECRET=

# Inbound postback HMAC secret (also configure on the postback relay). The live
# gate and preflight refuse to arm live while this is empty, shorter than 32
# characters, or still this placeholder. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
ANGEL_WEBHOOK_SECRET=generate_another_long_random_secret

# SQL console connection for a read-only NOSUPERUSER role (role SQL in
# dashboard/backend/qsdash/api/dbadmin.py). Unset: the console runs on the
# app's own role, guarded only by text checks. Set it before arming live.
CONSOLE_DATABASE_URL=

# Outbound alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Dashboard
PUBLIC_ORIGIN=https://quant.devpilotx.com
# Optional: comma-separated CIDRs allowed to reach the dashboard (empty = any)
IP_ALLOWLIST=
